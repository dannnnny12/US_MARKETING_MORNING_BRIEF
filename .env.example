# Anthropic Console API Key
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-sonnet-4-5

# 寄Email參數: Gmail example (use Google App Password, not account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your-16-character-app-password
EMAIL_FROM=youraddress@gmail.com
EMAIL_TO=youraddress@gmail.com

# LINE Messaging API參數
LINE_CHANNEL_ACCESS_TOKEN=your-channel-access-token
LINE_USER_ID=your-line-user-id # 需透過Ngrok取得Line user的ID，需安裝並啟動Ngrok & get_line_user_id.py並監聽line user輸入的訊息，才能取得user id

TIMEZONE=Asia/Taipei
HOURS_BACK=18
